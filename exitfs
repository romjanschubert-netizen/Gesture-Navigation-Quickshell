#!/bin/sh
# Beendet Vollbild unter Hyprland >= 0.55 (Lua-Dispatcher)
a=$(hyprctl clients -j | jq -r '.[]|select((.fullscreen//0)>0 or (.fullscreenClient//0)>0)|.address' | head -1)
[ -z "$a" ] && exit 0
hyprctl dispatch "hl.dsp.window.fullscreen_state({ internal = 0, client = 0, action = 'set', window = 'address:$a' })"
sleep 0.2
hyprctl dispatch "hl.dsp.window.fullscreen({ mode = 'fullscreen', action = 'unset', window = 'address:$a' })"
